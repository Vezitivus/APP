# Copy to .env.local for local development. Never commit real values.
# Vercel: Project → Settings → Environment Variables. All of these stay server-side
# except the two NEXT_PUBLIC_ values, which are a public Supabase anon key by design.

# Supabase Postgres transaction pooler (port 6543), not the direct 5432 URL.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Set to disable only for a local Postgres without SSL.
# DATABASE_SSL=disable

# At least 8 characters. This is the only admin password. It is not stored in git.
ADMIN_PASSWORD=change-me-to-a-long-random-password
# At least 32 random characters. Signs admin, player, and TV cookies.
SESSION_SECRET=change-me-to-a-random-string-at-least-32-characters

# Public site origin used in links the organizer copies. No trailing slash.
PUBLIC_URL=https://your-app.vercel.app

# Cloudinary. The secret must never use a NEXT_PUBLIC_ name.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional. Enables Supabase Realtime on the public TV feed. The anon key is
# meant to be public; row level security blocks every other table.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
